# Copy this file to .env and fill it in. NEVER commit .env (it is in .gitignore).

# --- Required ---------------------------------------------------------------
DISCORD_TOKEN=            # Discord developer portal > your app > Bot > Reset Token
APPLICATION_ID=           # Discord developer portal > your app > General Information
ANTHROPIC_API_KEY=        # console.anthropic.com > API Keys (set a monthly spend limit there)
GUILD_ID=                 # right-click your server > Copy Server ID (turn on Developer Mode)
BUGS_CHANNEL_ID=          # the bug report FORUM channel (with game / device / status tags)
DEV_BUGS_FORUM_ID=        # a FORUM channel only devs can see; each dev gets a board post here
MODLOG_CHANNEL_ID=        # text channel where strikes that need a dev's confirmation are posted
DEV_ROLE_ID=              # role of your developers

# --- Optional ---------------------------------------------------------------
JR_DEV_ROLE_ID=           # junior devs: read only, cannot change statuses
BOUNTY_BOARD_CHANNEL_ID=  # channel with a "Claimed games" embed listing "[Game](link) · @dev". Without it, set owners with /config
UPDATES_CHANNEL_ID=       # default channel for game update announcements (a game's /config channel wins)
SUGGESTIONS_CHANNEL_ID=   # optional: the forum where players suggest improvements (same tags as the bug forum, spelling can differ)
DEV_SUGGESTIONS_FORUM_ID=   # optional: a FORUM channel only devs can see; each dev gets a suggestion board post here
DEV_LOG_CHANNEL_ID=   # optional: a private channel where every dev action (commands, buttons, status changes) is logged
TESTER_INFO_CHANNEL_ID=   # optional: channel with the old tester roster message (imported once into /tester)
RELEASES_ROLE_ID=         # optional: a role a new-game card can ping (the dev chooses on /release new)
UPDATES_PING_ROLE_ID=   # optional: the role an update announcement can ping (the dev chooses on Post)
TESTING_CHANNEL_ID=       # tester channel: enables /bug for testers (a thread per report is created here)
TESTER_ROLE_IDS=          # comma separated role IDs that may use /bug
TEST_CHANNEL_ID=          # a private channel used by /preview and scripts/preview.mjs
BOT_HELPER_ID=            # user ID shown in the launch announcement ("this bot will be moved to ...")
OWNER_ID=                 # user ID shown in the launch announcement ("report bugs to ...")
MODEL=claude-haiku-4-5-20251001   # Claude model used for triage
AI_DAILY_CAP=500          # max Claude calls per day, a safety net for your bill
FFMPEG_PATH=ffmpeg        # only if ffmpeg is not on PATH (needed for video frames in transcripts)
