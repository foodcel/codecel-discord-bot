[Unit]
Description=codecel Discord bug bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__NODE__ src/index.js
Restart=always
RestartSec=10
# keep the bot small and contained
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=__DIR__

[Install]
WantedBy=multi-user.target
